{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site on Workers Static Assets. No Worker script, no adapter.
  // Workers Builds runs `npm run build`, then `npx wrangler deploy` (main)
  // or `npx wrangler versions upload` (other branches = preview URLs).
  "name": "scorsync-support",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  "workers_dev": true
}
